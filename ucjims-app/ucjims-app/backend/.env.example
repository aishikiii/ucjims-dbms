# ==============================================================================
# UCJIMS Backend Environment Configuration Template (Local Development)
# Copy this file to .env and configure with your local development parameters.
# NEVER commit the real .env to git.
# ==============================================================================

# Database Connection (Oracle Instant Client / Thin Driver)
ORACLE_USER=UCJIMS_OWNER
ORACLE_PASSWORD=your_local_password
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# Stage 5 Least-Privilege Account (Optional if running as owner, required if running as UCJIMS_APP):
# ORACLE_USER=UCJIMS_APP
# ORACLE_SCHEMA=UCJIMS_OWNER

# Connection Pool Settings
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10

# API Server
PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change_this_to_a_cryptographically_secure_random_string_min_32_chars
JWT_EXPIRES_IN=8h

# CORS (Allowed Origins, comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
