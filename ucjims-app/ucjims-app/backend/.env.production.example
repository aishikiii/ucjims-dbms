# ==============================================================================
# UCJIMS Production Environment Configuration Template
# ==============================================================================

# Least-privilege application database user (isolated private network DB)
ORACLE_USER=UCJIMS_APP_PROD
ORACLE_PASSWORD=REPLACE_WITH_PRODUCTION_SECRET_MANAGER_VALUE
ORACLE_CONNECT_STRING=prod-db-cluster.internal:1521/PRODPDB1
ORACLE_SCHEMA=UCJIMS_OWNER_PROD

# Connection Pool Settings (Tuned for production throughput)
ORACLE_POOL_MIN=10
ORACLE_POOL_MAX=50

# API Server
PORT=4000
NODE_ENV=production

# JWT Authentication (Rotated via secret manager)
JWT_SECRET=REPLACE_WITH_PRODUCTION_SECRET_MANAGER_VALUE_MIN_64_CHARS
JWT_EXPIRES_IN=2h

# CORS (Strict production domain only)
CORS_ORIGIN=https://ucjims.gov.in
