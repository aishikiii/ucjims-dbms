# ==============================================================================
# UCJIMS Staging Environment Configuration Template
# ==============================================================================

# Least-privilege application database user (isolated staging schema)
ORACLE_USER=UCJIMS_APP_STAGING
ORACLE_PASSWORD=REPLACE_WITH_STAGING_VAULT_SECRET
ORACLE_CONNECT_STRING=staging-db.internal:1521/STGPDB1
ORACLE_SCHEMA=UCJIMS_OWNER_STAGING

# Connection Pool Settings
ORACLE_POOL_MIN=4
ORACLE_POOL_MAX=20

# API Server
PORT=4000
NODE_ENV=staging

# JWT Authentication
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_STAGING_KEY
JWT_EXPIRES_IN=4h

# CORS
CORS_ORIGIN=https://staging.ucjims.internal
